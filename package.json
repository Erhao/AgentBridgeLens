{
  "name": "agentbridgelens-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev:bridge": "pnpm --filter agentbridgelens dev",
    "dev:extension": "pnpm --filter @anthropic/agentbridgelens-extension dev",
    "zip": "pnpm --filter @anthropic/agentbridgelens-extension zip",
    "typecheck": "pnpm -r typecheck",
    "test:release": "node --test scripts/release/*.test.mjs",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "test:updater": "node --test scripts/update/*.test.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:desktop": "pnpm --dir packages/bridge test && pnpm test:contracts",
    "test:linux": "python3 -m unittest discover -s platforms/linux/tests -p \"test_*.py\" -v"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "semantic-release": "25.0.9"
  }
}
