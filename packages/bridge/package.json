{
  "name": "agentbridgelens",
  "version": "0.6.0",
  "description": "MCP bridge for real browser inspection and macOS, Windows and Linux desktop executors.",
  "type": "module",
  "bin": {
    "agentbridgelens": "./dist/index.js"
  },
  "files": [
    "dist",
    "linux-agent/*.py",
    "windows-agent/win-*/**",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "chrome-extension",
    "browser",
    "cdp",
    "debugging",
    "source-map"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erhao/AgentBridgeLens.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/Erhao/AgentBridgeLens#readme",
  "scripts": {
    "build": "node ../../scripts/build/stage-linux.mjs && tsup",
    "dev": "node ../../scripts/build/stage-linux.mjs && tsup --watch --onSuccess \"node dist/index.js\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepublishOnly": "node ../../scripts/build/stage-linux.mjs && tsup"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "@agentbridgelens/protocol": "workspace:*",
    "@agentbridgelens/runtime": "workspace:*",
    "@agentbridgelens/browser-adapter": "workspace:*",
    "@agentbridgelens/desktop": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
